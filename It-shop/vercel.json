{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/lt-shop/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-8990.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api-production-8990.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
